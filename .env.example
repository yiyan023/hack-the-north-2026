# Optional: required for X and Gemini. Public news + local grounded copy works without keys.
PORT=3000
BROWSERBASE_API_KEY=
# Persistent Browserbase profile used for authenticated X searches.
BROWSERBASE_CONTEXT_ID=
BROWSERBASE_REGION=us-east-1
BROWSERBASE_SESSION_TIMEOUT_SEC=21600
ENABLE_TEST_FEED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Performance controls
POLL_INTERVAL_MS=12000
BUFFER_SIZE=100
POSTS_PER_BATCH=10
GEMINI_CONTEXT_POSTS=3
MAX_POSTS_PER_GENERATION=30
GEMINI_CONTEXT_POSTS=3
GEMINI_CONCURRENCY=3
GEMINI_MIN_INTERVAL_MS=20000
MIN_NEW_POSTS=5
SUGGESTION_MAX_AGE_MS=45000
SENTIMENT_REFRESH_INTERVAL_MS=60000
SENTIMENT_CHANGE_THRESHOLD=0.35
