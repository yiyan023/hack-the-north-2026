# The server runs without keys in demo mode. Add both keys for the real pipeline.
PORT=3000
BROWSERBASE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Performance controls
POLL_INTERVAL_MS=12000
BUFFER_SIZE=100
POSTS_PER_BATCH=10
MAX_POSTS_PER_GENERATION=30
GEMINI_CONCURRENCY=3
GEMINI_MIN_INTERVAL_MS=20000
MIN_NEW_POSTS=5
SUGGESTION_MAX_AGE_MS=45000

# Set true to use deterministic local data even when keys are present.
FORCE_DEMO_MODE=false
