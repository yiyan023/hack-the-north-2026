# Optional: required for X/Reddit and Gemini. Public news + local grounded copy works without keys.
PORT=3000
BROWSERBASE_API_KEY=
# Optional persistent Browserbase profile used for authenticated X searches.
BROWSERBASE_CONTEXT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Performance controls
POLL_INTERVAL_MS=12000
BUFFER_SIZE=100
POSTS_PER_BATCH=10
MAX_POSTS_PER_GENERATION=30
GEMINI_CONCURRENCY=3
GEMINI_MIN_INTERVAL_MS=20000
MIN_NEW_POSTS=5
SUGGESTION_MAX_AGE_MS=45000
